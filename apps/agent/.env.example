# Backend "mistral" (default) atau "openrouter"
DEV_DOCTOR_BACKEND=mistral

# Untuk backend mistral (platform.mistral.ai):
MISTRAL_API_KEY=

# Untuk gateway OpenAI-compatible seperti Xkiro atau OpenRouter:
# DEV_DOCTOR_BASE_URL=https://api.xkiro.com/v1
# OPENROUTER_API_KEY=
# Opsional, override model:
# DEV_DOCTOR_MODEL=cohere/command-a
